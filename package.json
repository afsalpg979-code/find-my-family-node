{
  "name": "find-my-family",
  "version": "1.0.0",
  "private": true,
  "description": "Find My Family - mobile-first family contacts, GPS sharing and community chat",
  "main": "server.js",
  "scripts": {
    "dev": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "build": "npm --prefix frontend run build",
    "start": "node server.js",
    "health": "node -e \"fetch('http://127.0.0.1:3000/health').then(r=>r.json()).then(console.log).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "express": "^5.1.0"
  }
}